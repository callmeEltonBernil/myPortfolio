/* Reset and base styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    /* Minimalist Monochromatic Color Palette */
    --primary-color: #000000;        /* Black - Primary text & headers */
    --secondary-color: #1a1a1a;      /* Dark gray - Text */
    --accent-color: #333333;         /* Medium gray - Accents */
    --success-color: #333333;        /* Gray - Success states */
    --text-color: #555555;           /* Slate Gray - Body text */
    --text-light: #888888;           /* Lighter gray - Secondary text */
    --light-bg: #f5f5f5;             /* Off-white - Background */
    --white: #ffffff;                /* Pure white */
    --border-color: #d0d0d0;         /* Light border */
    --gradient-1: linear-gradient(135deg, #1a1a1a 0%, #333333 100%);
    --gradient-2: linear-gradient(135deg, #f8f8f8 0%, #e0e0e0 100%);
    --gradient-3: linear-gradient(135deg, #e0e0e0 0%, #f5f5f5 100%);
}

body {
    font-family: 'Poppins', sans-serif;
    line-height: 1.6;
    color: var(--text-color);
    background-color: var(--light-bg);
}

/* Header styles */
header {
    background: var(--white);
    padding: 1.2rem 5%;
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 1000;
    box-shadow: 0 2px 15px rgba(0,0,0,0.1);
}

nav ul {
    display: flex;
    justify-content: flex-end;
    list-style: none;
    gap: 2.5rem;
}

nav ul li {
    position: relative;
}

/* Updated navigation link styles with new hover effect */
nav ul li a {
    text-decoration: none;
    color: var(--secondary-color);
    font-weight: 500;
    font-size: 1.1rem;
    padding: 8px 16px;
    position: relative;
    transition: color 0.3s ease;
    z-index: 1;
}

/* New background hover animation */
.hover-animation {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 0;
    background: var(--primary-color);
    opacity: 0.1;
    transition: height 0.3s ease;
    z-index: -1;
    border-radius: 4px;
}

/* Hover states */
nav ul li a:hover {
    color: var(--primary-color);
}

nav ul li a:hover .hover-animation {
    height: 100%;
}

/* Active state */
nav ul li a.active .hover-animation {
    height: 100%;
    background: var(--primary-color);
    opacity: 0.15;
}

/* Optional: Add a subtle scale effect */
nav ul li a {
    transform: scale(1);
    transition: transform 0.3s ease;
}

nav ul li a:hover {
    transform: scale(1.05);
}

/* Hero section */
#home {
    min-height: 100vh;
    padding: 80px 5% 0;
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, var(--secondary-color) 0%, #1e293b 50%, var(--primary-color) 100%);
    position: relative;
    overflow: hidden;
}

#home::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 30% 50%, rgba(99, 102, 241, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 70% 50%, rgba(245, 158, 11, 0.1) 0%, transparent 50%);
    pointer-events: none;
}

.hero {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    height: calc(100vh - 80px);
}

.hero-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 2rem;
}

.hero-text {
    flex: 1;
    padding: 2rem 0;
    color: var(--white);
    animation: fadeInLeft 1s ease;
}

.hero-text h1 {
    font-size: 3.5rem;
    margin-bottom: 1rem;
    line-height: 1.2;
}

.hero-text p {
    font-size: 1.5rem;
    margin-bottom: 2rem;
    opacity: 0.9;
}

.hero-buttons {
    display: flex;
    gap: 1rem;
}

.primary-btn {
    background: var(--accent-color);
    color: var(--white);
    padding: 1rem 2rem;
    border-radius: 30px;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
}

.secondary-btn {
    background: transparent;
    color: var(--white);
    padding: 1rem 2rem;
    border-radius: 30px;
    font-weight: 600;
    border: 2px solid var(--white);
    transition: all 0.3s ease;
}

.primary-btn:hover {
    background: #d97706;
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(245, 158, 11, 0.4);
}

.secondary-btn:hover {
    background: var(--white);
    color: var(--secondary-color);
    transform: translateY(-3px);
}

.hero-image {
    flex: 1;
    animation: fadeInRight 1s ease;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
}

.hero-image img {
    max-width: 720px;
    width: 240%;
    height: auto;
    filter: drop-shadow(0 10px 30px rgba(99, 102, 241, 0.3));
    opacity: 1;
    transition: all 0.3s ease;
    object-fit: contain;
    margin-left: 40%;
    transform: translateY(-36px) scale(1.3);
}

.hero-image img:hover {
    filter: drop-shadow(0 15px 40px rgba(99, 102, 241, 0.4));
    transform: translateY(-18px) scale(1.30);
}

/* About section */
#about {
    padding: 6rem 5%;
    background: var(--white);
}

.about-content {
    display: flex;
    gap: 4rem;
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
}

.about-content img {
    width: 500px;
    height: 600px;
    border-radius: 2%;
    object-fit: cover;
    box-shadow: 0 0 20px rgba(0,0,0,0.1);
    transition: transform 0.3s ease;
}

.about-content img:hover {
    transform: scale(1.05);
}

.about-text {
    flex: 1;
}

.skills {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
}

.skills span {
    background: var(--primary-color);
    color: var(--white);
    padding: 0.8rem 1.5rem;
    border-radius: 25px;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.skills span i {
    font-size: 1.2rem; /* Makes icons slightly larger than text */
}

/* Optional: Add specific colors for each technology */
.skills span:nth-child(1) i { color: #E44D26; } /* HTML5 color */
.skills span:nth-child(2) i { color: #264DE4; } /* CSS3 color */
.skills span:nth-child(3) i { color: #F7DF1E; } /* JavaScript color */
.skills span:nth-child(4) i { color: #61DAFB; } /* React color */

/* Hover effect */
.skills span:hover {
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.2);
}

/* Optional: Add rotation animation for React icon */
.skills span:nth-child(4) i {
    animation: spin 4s linear infinite;
}

@keyframes spin {
    from {
        transform: rotate(0deg);
    }
    to {
        transform: rotate(360deg);
    }
}

/* Certifications section - Enhanced Design */
#certifications {
    padding: 6rem 5%;
    background: var(--white);
    position: relative;
    overflow: hidden;
}

#certifications::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 20% 50%, rgba(99, 102, 241, 0.03) 0%, transparent 50%),
                radial-gradient(circle at 80% 50%, rgba(245, 158, 11, 0.03) 0%, transparent 50%);
    pointer-events: none;
}

.certifications-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
    gap: 3rem;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
}

.cert-card {
    background: var(--white);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(15, 23, 42, 0.08);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    border: 1px solid var(--border-color);
}

.cert-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: var(--gradient-1);
    transform: scaleX(0);
    transition: transform 0.4s ease;
    transform-origin: left;
}

.cert-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 60px rgba(99, 102, 241, 0.15);
}

.cert-card:hover::before {
    transform: scaleX(1);
}

.cert-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 60px;
    height: 60px;
    background: var(--gradient-1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
    animation: float 3s ease-in-out infinite;
    z-index: 2;
}

.cert-badge i {
    color: var(--white);
    font-size: 1.8rem;
}

@keyframes float {
    0%, 100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-10px);
    }
}

.cert-content {
    padding: 2.5rem;
}

.cert-title {
    color: var(--secondary-color);
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: 1rem;
    line-height: 1.4;
    padding-right: 70px;
}

.cert-issuer {
    color: var(--primary-color);
    font-size: 1.05rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.cert-issuer i {
    font-size: 1.2rem;
}

.cert-date {
    color: var(--text-light);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.cert-date i {
    color: var(--accent-color);
}

.cert-image-container {
    position: relative;
    margin: 1.5rem 0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.1);
    cursor: pointer;
}

.cert-image {
    width: 100%;
    height: auto;
    display: block;
    transition: all 0.4s ease;
}

.cert-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(99, 102, 241, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: all 0.3s ease;
}

.cert-overlay i {
    color: var(--white);
    font-size: 3rem;
    transform: scale(0);
    transition: all 0.3s ease 0.1s;
}

.cert-image-container:hover .cert-overlay {
    opacity: 1;
}

.cert-image-container:hover .cert-overlay i {
    transform: scale(1);
}

.cert-image-container:hover .cert-image {
    transform: scale(1.05);
}

/* Enhanced Certificate Button Design */
.cert-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 1rem 2rem;
    background: var(--gradient-1);
    color: var(--white);
    text-decoration: none;
    border-radius: 50px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
}

.cert-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.5s ease;
}

.cert-btn:hover::before {
    left: 100%;
}

.cert-btn i {
    font-size: 0.9rem;
    transition: transform 0.3s ease;
}

.cert-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(99, 102, 241, 0.4);
}

.cert-btn:hover i {
    transform: translateX(3px);
}

.cert-btn:active {
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
}

/* Projects section */
#projects {
    padding: 6rem 5%;
    background: var(--light-bg);
}

.project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2.5rem;
    max-width: 1200px;
    margin: 2rem auto 0;
}

.project-card {
    background: var(--white);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(15, 23, 42, 0.08);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid var(--border-color);
    position: relative;
}

.project-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--gradient-1);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
}

.project-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 20px 60px rgba(99, 102, 241, 0.15);
}

.project-card:hover::before {
    transform: scaleX(1);
}

.project-card img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.project-card:hover img {
    transform: scale(1.05);
}

.project-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    background: var(--gradient-1);
    color: var(--white);
    padding: 0.5rem 1.2rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
    z-index: 10;
}

.project-card h3 {
    padding: 1.5rem 1.5rem 0.5rem;
    color: var(--secondary-color);
    font-size: 1.5rem;
    font-weight: 700;
}

.project-card p {
    padding: 0 1.5rem;
    color: var(--text-light);
    line-height: 1.7;
    margin-bottom: 1rem;
}

.project-tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0 1.5rem 1rem;
}

.tech-tag {
    padding: 0.4rem 1rem;
    background: rgba(99, 102, 241, 0.1);
    color: var(--primary-color);
    border-radius: 15px;
    font-size: 0.75rem;
    font-weight: 600;
    border: 1px solid rgba(99, 102, 241, 0.2);
    transition: all 0.3s ease;
}

.tech-tag:hover {
    background: var(--primary-color);
    color: var(--white);
    transform: translateY(-2px);
}

.project-buttons {
    display: flex;
    gap: 0.8rem;
    padding: 0 1.5rem 1.5rem;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.5rem;
    text-decoration: none;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    flex: 1;
}

.btn-primary {
    background: var(--primary-color);
    color: var(--white);
}

.btn-primary:hover {
    background: var(--secondary-color);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
}

.btn-secondary {
    background: transparent;
    color: var(--primary-color);
    border: 2px solid var(--primary-color);
}

.btn-secondary:hover {
    background: var(--primary-color);
    color: var(--white);
    transform: translateY(-2px);
}

