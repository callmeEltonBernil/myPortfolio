}

/* Figma Button */
.ux-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    padding: 0.9rem 1.8rem;
    background: var(--white);
    color: var(--primary-color);
    text-decoration: none;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 2px solid var(--primary-color);
    position: relative;
    overflow: hidden;
}

.ux-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--gradient-1);
    transform: translateY(100%);
    transition: transform 0.3s ease;
    z-index: -1;
}

.ux-btn:hover::before {
    transform: translateY(0);
}

.ux-btn:hover {
    color: var(--white);
    border-color: transparent;
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(99, 102, 241, 0.3);
}

.ux-btn i {
    font-size: 1.1rem;
    transition: transform 0.3s ease;
}

.ux-btn:hover i {
    transform: scale(1.1) rotate(5deg);
}

.ux-btn:active {
    transform: translateY(-1px);
}

/* Contact section */
#contact {
    padding: 6rem 5%;
    background: var(--light-bg);
}

.contact-content {
    display: flex;
    align-items: flex-start;
    gap: 4rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
}

.contact-content img {
    width: 400px;
    height: auto;
    border-radius: 15px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

.contact-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

.reach-out, .social-connect {
    background: var(--white);
    padding: 1.5rem;
    border-radius: 10px;
    box-shadow: 0 3px 10px rgba(0,0,0,0.1);
}

.reach-out h3, .social-connect h3 {
    color: var(--secondary-color);
    margin-bottom: 1rem;
    font-size: 1.5rem;
}

.contact-details {
    margin-top: 1rem;
}

.contact-details .name {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--primary-color);
    margin-bottom: 0.5rem;
}

.contact-details .email {
    color: var(--text-color);
    font-size: 1.1rem;
}

.social-icons {
    display: flex;
    gap: 1.5rem;
}

.social-icons a {
    font-size: 1.8rem;
    color: var(--secondary-color);
    transition: all 0.3s ease;
}

.social-icons a:hover {
    transform: translateY(-3px);
}

/* Specific colors for social media icons */
.social-icons a:nth-child(1) { /* Facebook */
    color: #1877f2;
}

.social-icons a:nth-child(2) { /* Instagram */
    color: #e4405f;
}

.social-icons a:nth-child(3) { /* LinkedIn */
    color: #0077b5;
}

/* Contact Form Styling */
form {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

form input, form textarea {
    padding: 1rem;
    border: 2px solid #eee;
    border-radius: 8px;
    font-size: 1rem;
    transition: border-color 0.3s ease;
}

form input:focus, form textarea:focus {
    outline: none;
    border-color: var(--primary-color);
}

form textarea {
    min-height: 150px;
    resize: vertical;
}

/* Footer */
footer {
    background: var(--secondary-color);
    color: var(--white);
    text-align: center;
    padding: 2rem;
}

/* Section headers */
h2 {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 3rem;
    color: var(--secondary-color);
    position: relative;
}

h2::after {
    content: '';
    display: block;
    width: 50px;
    height: 3px;
    background: var(--primary-color);
    margin: 0.5rem auto;
}

/* Lightbox Modal Styles */
.lightbox {
    display: none;
    position: fixed;
    z-index: 9999;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.95);
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.lightbox.active {
    opacity: 1;
}

.lightbox-content {
    max-width: 90%;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 0 50px rgba(99, 102, 241, 0.5);
    animation: zoomIn 0.3s ease;
}

@keyframes zoomIn {
    from {
        transform: scale(0.8);
        opacity: 0;
    }
    to {
        transform: scale(1);
        opacity: 1;
    }
}

.lightbox-close {
    position: absolute;
    top: 30px;
    right: 50px;
    color: var(--white);
    font-size: 3rem;
    font-weight: 300;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 10000;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    backdrop-filter: blur(10px);
}

.lightbox-close:hover {
    color: var(--accent-color);
    background: rgba(245, 158, 11, 0.2);
    transform: rotate(90deg);
}

.lightbox-caption {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--white);
    font-size: 1.3rem;
    font-weight: 600;
    text-align: center;
    padding: 1rem 2rem;
    background: rgba(0, 0, 0, 0.7);
    border-radius: 30px;
    backdrop-filter: blur(10px);
    max-width: 80%;
}

.lightbox-nav {
    position: absolute;
    top: 50%;
    width: 100%;
    display: flex;
    justify-content: space-between;
    padding: 0 30px;
    transform: translateY(-50%);
    pointer-events: none;
}

.lightbox-prev,
.lightbox-next {
    pointer-events: all;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.3);
    color: var(--white);
    font-size: 1.5rem;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(10px);
}

.lightbox-prev:hover,
.lightbox-next:hover {
    background: var(--primary-color);
    border-color: var(--primary-color);
    transform: scale(1.1);
}

.lightbox-prev:active,
.lightbox-next:active {
    transform: scale(0.95);
}

.lightbox-prev i,
.lightbox-next i {
    pointer-events: none;
}

/* Make UX project images more clickable */
.ux-project-image {
    cursor: pointer;
}

.ux-project-image::after {
    content: '\f00e'; /* Font Awesome expand icon */
    font-family: "Font Awesome 5 Free";
    font-weight: 900;
    position: absolute;
    bottom: 15px;
    right: 15px;
    color: var(--white);
    background: rgba(99, 102, 241, 0.9);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    opacity: 0;
    transition: all 0.3s ease;
    pointer-events: none;
}

.ux-project-card:hover .ux-project-image::after {
    opacity: 1;
    bottom: 20px;
}

/* Responsive Lightbox */
@media (max-width: 768px) {
    .lightbox-content {
        max-width: 95%;
        max-height: 80vh;
    }

    .lightbox-close {
        top: 20px;
        right: 20px;
        font-size: 2.5rem;
        width: 45px;
        height: 45px;
    }

    .lightbox-caption {
        font-size: 1rem;
        padding: 0.8rem 1.5rem;
        bottom: 80px;
    }

    .lightbox-prev,
    .lightbox-next {
        width: 50px;
        height: 50px;
        font-size: 1.2rem;
    }

    .lightbox-nav {
        padding: 0 15px;
    }
}

@media (max-width: 480px) {
    .lightbox-content {
        max-width: 100%;
        max-height: 75vh;
    }

    .lightbox-close {
        top: 15px;
        right: 15px;
        font-size: 2rem;
        width: 40px;
        height: 40px;
    }

    .lightbox-caption {
        font-size: 0.9rem;
        padding: 0.6rem 1rem;
        bottom: 70px;
        max-width: 90%;
    }

    .lightbox-prev,
    .lightbox-next {
        width: 45px;
        height: 45px;
        font-size: 1rem;
    }
}

/* Animations */
@keyframes fadeInDown {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fadeInLeft {
    from {
        opacity: 0;
        transform: translateX(-50px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes fadeInRight {
    from {
        opacity: 0;
        transform: translateX(50px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

